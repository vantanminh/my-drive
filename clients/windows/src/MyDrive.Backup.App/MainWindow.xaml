<Window x:Class="MyDrive.Backup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Drive Backup"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{StaticResource Nav}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,22,20,8">
          <TextBlock Text="My Drive" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="NavSubtitle" Text="Backup" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel x:Name="Navigation" Margin="12,12,12,20" />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <ContentControl x:Name="Pages" Margin="28" />
      <Border x:Name="SetupHost" Background="#CC0E141B" Visibility="Collapsed">
        <ContentControl x:Name="SetupPage" Margin="80" />
      </Border>
    </Grid>
  </Grid>
</Window>
