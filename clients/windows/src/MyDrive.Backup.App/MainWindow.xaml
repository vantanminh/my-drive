<Window x:Class="MyDrive.Backup.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Drive Backup"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource Nav}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="20,26,20,6">
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="13" Background="{DynamicResource Accent}">
              <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="My Drive" Foreground="{DynamicResource SidebarText}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock x:Name="NavSubtitle" Text="Backup" Foreground="{DynamicResource SidebarMuted}" FontSize="12" Margin="0,1,0,0" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="16,8,16,18" Padding="14,12" CornerRadius="16" Background="#14FFFFFF">
          <StackPanel>
            <TextBlock x:Name="SidebarAccount" Text="Not signed in" Foreground="{DynamicResource SidebarText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SidebarServer" Text="No server" Foreground="{DynamicResource SidebarMuted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

        <StackPanel x:Name="Navigation" Margin="14,18,14,8" />
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Padding="32,20,28,18" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource Card}">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Content="Pause" Click="Pause_Click" />
            <Button x:Name="BackupButton" Style="{StaticResource PrimaryButton}" Content="Backup now" Margin="0" Click="Backup_Click" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
            <TextBlock x:Name="PageSubtitle" Margin="0,3,24,0" Foreground="{DynamicResource Muted}" FontSize="13" Text="Your folders stay protected from this computer." TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border x:Name="ServiceBanner" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource DangerSoft}" Padding="32,12,28,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button x:Name="RetryServiceButton" DockPanel.Dock="Right" Content="Retry" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="Retry_Click" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ServiceBannerTitle" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" Text="Backup service is not running" />
            <TextBlock x:Name="ServiceBannerBody" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" FontSize="12.5" Margin="0,3,12,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
          <ContentControl x:Name="Pages" VerticalAlignment="Top" />
        </ScrollViewer>
        <Border x:Name="SetupHost" Background="#990E141B" Visibility="Collapsed">
          <Border MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28"
                  Background="{DynamicResource Card}" CornerRadius="22" Padding="28"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <ContentControl x:Name="SetupPage" />
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
