<Application x:Class="MyDrive.Backup.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Bg" Color="#F6F4EF" />
      <SolidColorBrush x:Key="Nav" Color="#1B2430" />
      <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Text" Color="#1C2430" />
      <SolidColorBrush x:Key="Muted" Color="#667085" />
      <SolidColorBrush x:Key="Accent" Color="#0F766E" />
      <SolidColorBrush x:Key="AccentSoft" Color="#CCFBF1" />
      <SolidColorBrush x:Key="Line" Color="#E7E2D8" />
      <SolidColorBrush x:Key="Danger" Color="#B42318" />
      <SolidColorBrush x:Key="DangerSoft" Color="#FEF3F2" />
      <SolidColorBrush x:Key="Ok" Color="#067647" />
      <SolidColorBrush x:Key="OkSoft" Color="#E7F6EE" />
      <SolidColorBrush x:Key="Warning" Color="#B54708" />
      <SolidColorBrush x:Key="WarningSoft" Color="#FEF4E6" />
      <SolidColorBrush x:Key="SidebarText" Color="#F8FAFC" />
      <SolidColorBrush x:Key="SidebarMuted" Color="#94A3B8" />
      <SolidColorBrush x:Key="Input" Color="#FFFFFF" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
