# Copy this file to .env only for local development. Production values belong
# in the service manager's secret store. Never commit .env.

DATABASE_URL=postgres://mydrive:replace-with-generated-hex-secret@127.0.0.1:5432/mydrive
BIND_ADDR=127.0.0.1:3000

# Required by compose.yaml. Use a hex-only PostgreSQL password so it can be
# embedded in DATABASE_URL without URL escaping.
POSTGRES_PASSWORD=
MEDIA_INDEXER_PASSWORD=
POSTGRES_DATA_SSD=/var/lib/my-drive/postgres
STORAGE_DATA_HDD=/srv/my-drive/data
STORAGE_EXPECTED_DEVICE=
MEDIA_PREVIEW_DATA_SSD=/var/lib/my-drive/previews
MEDIA_PREVIEW_EXPECTED_DEVICE=
MY_DRIVE_IMAGE=ghcr.io/vantanminh/my-drive:latest
MY_DRIVE_INDEXER_IMAGE=ghcr.io/vantanminh/my-drive-indexer:latest

# Development-only local folder. Production must use an HDD mount and keep
# STORAGE_REQUIRE_MOUNT=true.
STORAGE_ROOT=C:/my-drive-dev-data
STORAGE_EXPECTED_MOUNT=C:/my-drive-dev-data
STORAGE_REQUIRE_MOUNT=false
STORAGE_REQUIRE_DEVICE_MATCH=false
STORAGE_EXPECTED_DEVICE=
MEDIA_PREVIEW_ROOT=C:/my-drive-dev-previews
MEDIA_PREVIEW_EXPECTED_MOUNT=C:/my-drive-dev-previews
MEDIA_PREVIEW_REQUIRE_MOUNT=false
MEDIA_PREVIEW_REQUIRE_DEVICE_MATCH=false
MEDIA_PREVIEW_EXPECTED_DEVICE=

MAX_FILE_SIZE=5368709120
OWNER_QUOTA_BYTES=107374182400
MIN_FREE_BYTES=5368709120
MIN_FREE_PERCENT=5
UPLOAD_SESSION_TTL=86400
TRASH_RETENTION_DAYS=30
SESSION_TTL=604800

# Set both values together to create the first owner. Use a unique long
# password; there is no built-in default account.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
COOKIE_SECURE=false

# Optional Google Drive import. Set all four values together, or leave them
# empty to keep the feature disabled. The redirect URI must match the OAuth
# client, and GOOGLE_DRIVE_TOKEN_KEY must be 64 hex characters.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_TOKEN_KEY=
