# Copy to .env.local and change every password before starting local Docker.
# Keep database passwords hex-only because Compose embeds them in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-64-hex-characters
MEDIA_INDEXER_PASSWORD=replace-with-a-different-64-hex-value
BOOTSTRAP_OWNER_EMAIL=owner@example.test
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-password-at-least-16-chars
APP_PORT=3000
MY_DRIVE_IMAGE=my-drive:local
MY_DRIVE_INDEXER_IMAGE=my-drive-indexer:local
MY_DRIVE_INDEXER_DB_SETUP_IMAGE=my-drive-indexer-db-setup:local
